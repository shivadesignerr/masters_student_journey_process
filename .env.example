# ==============================================================================
# GVK EDUTECH — MASTERS STUDENT & COUNSELOR MANAGEMENT PLATFORM
# Environment Configuration Blueprint
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public API (Accessible by browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Storage Bucket Names
NEXT_PUBLIC_STORAGE_BUCKET_DOCUMENTS=gvk-documents-private
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS=gvk-avatars

# Optional: Zoom API credentials for automated mock interview links
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# Email / Notification Provider (Resend / SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="GVK Edutech <notifications@gvkedutech.com>"
